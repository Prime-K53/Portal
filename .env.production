# Production / build environment — loaded by Vite ONLY when running
# `npm run build`. For local development, see .env.development (port 3000).
#
# Secrets (SUPABASE_*, etc.) are NOT stored here — they are configured
# directly in the Vercel project dashboard. This file only contains
# non-sensitive build-time configuration.
VITE_API_URL=https://primeerpsystem.onrender.com
VITE_USE_REAL_BACKEND=true
VITE_ENABLE_MOCK_API=false
VITE_ENABLE_MOCK_AUTH=false
VITE_API_TIMEOUT_MS=15000
