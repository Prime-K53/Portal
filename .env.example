# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ─── Prime PORTAL — ERP integration configuration ───────────────────────────
#
# VITE_API_URL: Origin (scheme + host + port) of the PrimeERPsystem Portal API,
# WITHOUT the /api suffix. The client composes `${VITE_API_URL}/api` per the
# Phase 3 ERP contract, e.g. VITE_API_URL="https://portal.erp.example.com".
VITE_API_URL=""

# VITE_API_TIMEOUT_MS: Per-request timeout in milliseconds (default 15000).
VITE_API_TIMEOUT_MS="15000"

# VITE_USE_REAL_BACKEND: 'true' forces the REAL ERP backend and disables every
# mock implementation. Production MUST set this to 'true' — API failures stay
# failures and are never replaced with mock data.
VITE_USE_REAL_BACKEND="true"

# DEVELOPMENT ONLY — NEVER set these in production.
#
# VITE_ENABLE_MOCK_API: 'true' serves the in-memory mock PortalService so the UI
# can be developed before the ERP API is connected.
VITE_ENABLE_MOCK_API="false"

# VITE_ENABLE_MOCK_AUTH: 'true' enables the in-memory mock AuthService
# (accepts any non-empty credentials, produces a clearly-marked demo session).
VITE_ENABLE_MOCK_AUTH="false"