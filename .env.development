# Development environment — loaded by Vite ONLY when running `npm run dev`.
#
# This file is automatically git-ignored (.gitignore line: .env*.local).
# For production builds, Vite uses .env.production (or .env if that's missing).
#
# VITE_API_URL: Local backend origin. The ERP backend should be running on
# port 3000 (e.g. `cd "Prime ERP System/backend" && node index.cjs` or
# `npm run dev` if the backend has its own dev script). The Portal dev server
# runs on port 3001 — keep them separate so the proxy / CORS layer is
# exercised the same way it runs in production.
VITE_API_URL=http://localhost:3000

# In dev we always want the real backend, never the in-memory mock.
VITE_USE_REAL_BACKEND=true
VITE_ENABLE_MOCK_API=false
VITE_ENABLE_MOCK_AUTH=false
VITE_API_TIMEOUT_MS=15000
